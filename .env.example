# MongoDB credentials used to initialize the local database.
#
# These are DEVELOPMENT defaults only.
# Production should use its own strong credentials in the server's .env.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=devpassword


# MongoDB connection used when running the game locally with `pnpm dev`.
#
# MongoDB itself runs in Docker and is exposed only to localhost:27017.
# When the game runs inside Docker, Compose overrides this connection
# to use the Docker service hostname `mongo` instead of `localhost`.
MONGODB_URI=mongodb://admin:devpassword@localhost:27017/wordgame?authSource=admin