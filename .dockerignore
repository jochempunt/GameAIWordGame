# Everything listed here stays out of the Docker build context, and so out of the image.

# Secrets: the app gets its settings from compose at runtime, never from a baked-in file.
.env
.env.*

# Installed and built on the host; the image installs and builds its own.
node_modules
**/node_modules
client/dist
.venv
**/__pycache__

# Include only the trained runtime from the offline pipeline.
ml/**
!ml/humor/
!ml/humor/*.py
!ml/humor/requirements.txt
!ml/humor/artifacts/
!ml/humor/artifacts/model/
!ml/humor/artifacts/model/humor_ranker.cjs

# Not needed to build or run the game.
.git
.claude
.vscode
.idea
*.log
logs/
Dockerfile
.dockerignore
compose*.yaml
