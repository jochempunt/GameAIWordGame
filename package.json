{
  "name": "jackbox-test-01",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "tsx server/server.ts",
    "dev": "concurrently -n SERVER,VITE \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "dev:qr": "node scripts/qr.cjs",
    "db": "docker compose up -d mongo",
    "db:stop": "docker compose stop mongo",
    "db:logs": "docker compose logs -f mongo"
  },
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/paytone-one": "^5.3.0",
    "express": "^5.2.1",
    "mongodb": "^7.7.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
